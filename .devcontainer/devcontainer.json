{
  "name": "SpotiStats",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "index.html", "app.js"] }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8501 --bind 0.0.0.0"
  },
  "portsAttributes": {
    "8501": { "label": "SpotiStats", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
